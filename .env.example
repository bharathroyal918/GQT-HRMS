# ==============================================================================
# GQT HRMS & Recruitment CRM — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the repository root:
#    cp .env.example .env
# 2. Fill in the values for your deployment environment.
# 3. NEVER commit real secret values, passwords, or live API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Environment & Django Runtime
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
TIMEZONE=Asia/Kolkata
DJANGO_SETTINGS_MODULE=config.settings.production

# [CRITICAL SECRET] Minimum 50 characters, high-entropy cryptographic secret key
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-of-at-least-50-chars

# Comma-separated list of fully qualified domain names and internal service hosts
# In production, wildcards (*) or localhost-only lists are rejected by fail-closed invariants
DJANGO_ALLOWED_HOSTS=hrms.gqtech.in,backend,localhost

# ------------------------------------------------------------------------------
# 2. Container Ingress & Reverse Proxy Topology
# ------------------------------------------------------------------------------
# Host port published by the Nginx edge container (default: 80)
PORT=80

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
# [CRITICAL SECRET] Direct or Pooler Connection URI (PostgreSQL 16 via psycopg v3)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Individual connection parameters (alternative to DATABASE_URL):
DB_NAME=postgres
DB_USER=postgres.your-project-ref
# [CRITICAL SECRET] Strong database password (default/weak credentials rejected)
DB_PASSWORD=your-db-password-here
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

# Local Offline Development Fallback
# When True and DATABASE_URL is not provisioned, Django gracefully falls back
# to isolated local SQLite for rapid feature testing without an internet connection.
# Strictly prohibited when ENVIRONMENT=production.
USE_SQLITE_FOR_LOCAL_DEV=False

# ------------------------------------------------------------------------------
# 4. Network, CORS & CSRF Security
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed for CORS and CSRF
CORS_ALLOWED_ORIGINS=https://hrms.gqtech.in,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://hrms.gqtech.in,http://localhost:5173

# Cookie Security Flags (Must be True in production environments with HTTPS)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
JWT_COOKIE_SECURE=True

# Transport Layer Security (Enforced via Nginx X-Forwarded-Proto header)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 5. JWT Authentication & Token Lifetimes
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# [CRITICAL SECRET] Signing key for HS256 tokens
JWT_SIGNING_KEY=replace-with-secure-jwt-signing-secret-key-for-token-generation

# ------------------------------------------------------------------------------
# 6. Diagnostics, Logging & Audit
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 7. Communications & Third-Party Notification Providers
# ------------------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
# [CRITICAL SECRET] SMTP password or API token
EMAIL_HOST_PASSWORD=your-smtp-api-password-here
DEFAULT_FROM_EMAIL=noreply@gqtech.in

EMAIL_PROVIDER_BACKEND=smtp
WHATSAPP_PROVIDER_BACKEND=meta
# [CRITICAL SECRET] Meta WhatsApp Cloud API credentials
WHATSAPP_API_TOKEN=your-meta-whatsapp-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token-here
WHATSAPP_WEBHOOK_APP_SECRET=your-app-secret-here

# ------------------------------------------------------------------------------
# 8. Client / Frontend Configuration (Vite)
# NOTE: VITE_ variables are bundled into client code. NEVER put secrets here!
# ------------------------------------------------------------------------------
# In containerized production behind Nginx reverse proxy, use relative path /api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=GQT HRMS & Recruitment CRM
VITE_APP_ENV=production

# Supabase Public Integration Keys (Safe for frontend bundle)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# [CRITICAL SECRET] Backend-only service role key (NEVER expose to frontend)
SUPABASE_SECRET_KEY=sb_secret_your_secret_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
