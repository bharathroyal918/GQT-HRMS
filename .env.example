# ==============================================================================
# GQT HRMS & Recruitment CRM — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the backend root or project root:
#    cp .env.example .env
# 2. Fill in the values for your deployment environment.
# 3. NEVER commit real secret values, passwords, or live API keys to Git.
# ==============================================================================

# Core Application Environment
ENVIRONMENT=development
DEBUG=True
TIMEZONE=Asia/Kolkata
DJANGO_SECRET_KEY=django-insecure-dev-only-secret-key-must-be-rotated-for-production-min-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# Supabase PostgreSQL 16 Database Configuration
# ==============================================================================
# Direct Connection (Recommended for migrations, CLI commands, and session pooling):
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Individual connection parameters (alternative to DATABASE_URL):
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-db-password-here
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# Local Offline Development Fallback
# When True and DATABASE_URL is not provisioned, Django gracefully falls back
# to isolated local SQLite for rapid feature testing without an internet connection.
USE_SQLITE_FOR_LOCAL_DEV=True

# ==============================================================================
# Network, CORS & CSRF Security
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie Security Flags (Set to True in staging & production with HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
JWT_COOKIE_SECURE=False

# ==============================================================================
# JWT Authentication & Token Lifetimes
# ==============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=dev-jwt-signing-key-replace-in-production-environments

# ==============================================================================
# Diagnostics, Logging & Audit
# ==============================================================================
LOG_LEVEL=INFO

# ==============================================================================
# Client / Frontend Configuration (Vite)
# NOTE: VITE_ variables are bundled into client code. NEVER put secrets here!
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=GQT HRMS & Recruitment CRM
VITE_APP_ENV=development



# Supabase Connection Keys Template (Place real credentials in .env only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here